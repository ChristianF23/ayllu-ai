# Imagen mínima del sandbox: solo el motor de ejecución y su servidor HTTP.
# No copia el proyecto, .env ni dependencias de terceros.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN useradd --system --no-create-home --shell /usr/sbin/nologin sandbox

WORKDIR /srv
COPY utils/__init__.py utils/sandbox.py ./utils/
COPY sandbox_server/server.py ./server.py

USER sandbox
EXPOSE 8000
CMD ["python", "server.py"]
